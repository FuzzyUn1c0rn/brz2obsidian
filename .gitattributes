# Keep versioned text consistent across Windows and WSL.
* text=auto eol=lf

# Preserve archive and binary fixture bytes.
*.brz -text
*.BRZ -text
*.zip -text
*.pdf -text
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text

# Authored note evidence deliberately tests exact CRLF spelling.
tests/fixtures/minimal/*/Notes.md -text whitespace=cr-at-eol
