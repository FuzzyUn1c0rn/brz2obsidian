# Private source exports and retained user vaults
/brz/
*.[bB][rR][zZ]
!tests/fixtures/*.brz

# Disposable development artifacts and retained private backups
/tmp/
/.scratch/
/backups/

# Project environment and Python caches
/.venv/
__pycache__/
*.py[cod]
/.pytest_cache/
/.ruff_cache/
/.mypy_cache/

# Coverage and package build artifacts
/.coverage
/.coverage.*
/coverage.xml
/htmlcov/
/build/
/dist/
*.egg-info/
